;
; platform.bib - BSP modules for the ipod6g BSP
;
; The OAL (nk.exe) and kitl.dll are added to the image by the common
; build files. Drivers are added here as they are written.
;

MODULES
    ; the sound driver (kernel mode)
    ipodwav.dll        $(_FLATRELEASEDIR)\ipodwav.dll                  NK     SHK
    ; the disk driver (kernel mode, read only)
    ipoddsk.dll        $(_FLATRELEASEDIR)\ipoddsk.dll                  NK     SHK
    ; I2C bus 0 driver I2C1: (kernel mode): power chip and codec
    ipodi2c.dll        $(_FLATRELEASEDIR)\ipodi2c.dll                  NK     SHK
    ; battery and clock driver (kernel mode), the battery icon in the taskbar
    battdrvr.dll       $(_FLATRELEASEDIR)\battdrvr.dll                 NK     SHK
    battray.exe        $(_FLATRELEASEDIR)\battray.exe                  NK
    pwrinfo.exe        $(_FLATRELEASEDIR)\pwrinfo.exe                  NK
    dskinfo.exe        $(_FLATRELEASEDIR)\dskinfo.exe                  NK
    wavpanel.exe       $(_FLATRELEASEDIR)\wavpanel.exe                 NK
    ; restarts the iPod
    restart.exe        $(_FLATRELEASEDIR)\restart.exe                  NK
    ; click wheel: driver (kernel mode) and the program that turns it into keys
    ipodwhl.dll        $(_FLATRELEASEDIR)\ipodwhl.dll                  NK     SHK
    whlkeys.exe        $(_FLATRELEASEDIR)\whlkeys.exe                  NK
; Name             Path                                            Memory Type
; --------------   ---------------------------------------------   ------ ----

; @CESYSGEN IF CE_MODULES_DISPLAY
IF BSP_NODISPLAY
    ddi_nop.dll        $(_FLATRELEASEDIR)\ddi_nop.dll                  NK     SHMK
ELSE
    ; iPod classic LCD (src\drivers\ipodlcd), loaded by GWES in kernel mode
    ipodlcd.dll        $(_FLATRELEASEDIR)\ipodlcd.dll                  NK     SHMK
    ; GDI test screen (src\apps\lcdtest); run from Target Control: s lcdtest
    lcdtest.exe        $(_FLATRELEASEDIR)\lcdtest.exe                  NK
ENDIF BSP_NODISPLAY
; @CESYSGEN ENDIF CE_MODULES_DISPLAY

FILES
;   Name        Path                                            Memory Flags
;   ----------  ---------------------------------------------   -----------
; desktop shortcut of the click wheel's counts
    whlkeys.lnk    $(_FLATRELEASEDIR)\whlkeys.lnk                      NK
; desktop shortcut "Restart"
    restart.lnk    $(_FLATRELEASEDIR)\restart.lnk                      NK
    wavpanel.lnk   $(_FLATRELEASEDIR)\wavpanel.lnk                 NK
    dskinfo.lnk    $(_FLATRELEASEDIR)\dskinfo.lnk                  NK
    pwrinfo.lnk    $(_FLATRELEASEDIR)\pwrinfo.lnk                  NK
