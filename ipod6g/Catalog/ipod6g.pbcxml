  <Bsp Id="Bsp:CE-on-iPod:ipod6g:ARMV5">
    <Title>ipod6g: ARMV5</Title>
    <Description>Apple iPod classic (6th/7th gen, Samsung S5L8702, ARM926EJ-S), booted by the Rockbox bootloader</Description>
