;
; ipodwav.def - exports of the iPod's sound driver (stream prefix WAV).
; The WAV_* entry points come from Microsoft's wave MDD (wavemdd.lib); the
; PDD is wavepdd.cpp.
;
LIBRARY IPODWAV

EXPORTS
    WAV_Init
    WAV_Deinit
    WAV_Open
    WAV_Close
    WAV_IOControl
    WAV_PowerUp
    WAV_PowerDown
