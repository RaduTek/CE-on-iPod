* text=auto
# Build-system and source files: LF in the repo, CRLF in the working tree
dirs         text eol=crlf
sources      text eol=crlf
makefile     text eol=crlf
*.cmn        text eol=crlf
*.c          text eol=crlf
*.cpp        text eol=crlf
*.h          text eol=crlf
*.s          text eol=crlf
*.inc        text eol=crlf
*.def        text eol=crlf
*.bib        text eol=crlf
*.reg        text eol=crlf
*.dat        text eol=crlf
*.bat        text eol=crlf
*.ps1        text eol=crlf
*.sln        text eol=crlf
*.pbxml      text eol=crlf
*.pbcxml     text eol=crlf
*.html       text eol=crlf
platform.db  text eol=crlf
OSDesign.db  text eol=crlf
# Patches for other trees (Rockbox is LF): stored and checked out byte for byte
*.patch      -text
# Binary files: never touch
*.bmp        binary
*.suo        binary
*.ipod       binary
*.nb0        binary
*.img3       binary
*.bin        binary
Thumbs.db    binary
