!if 0
ipodtouch2g KITL (kitl.dll): serial KITL over UART0 (dock connector)
!endif

TARGETNAME=kitl
TARGETTYPE=DYNLINK
DLLENTRY=KitlDllMain

# Finish all previous directories before building this one
SYNCHRONIZE_DRAIN=1

DEFFILE=

NOLIBC=1

#
# kitlcore : KITL protocol core (KitlDllMain, KitlInit)
# oal_kitl : OALKitlInit, OEMKitlInit, serial framing (kitlserial.c)
# kitl_log : KITL_RETAILMSG output
# Library set as in the Microsoft 3DS_iMX27 BSP (Src\kitl\sources).
#
TARGETLIBS= \
    $(_COMMONOAKROOT)\lib\$(_CPUDEPPATH)\kitlcore.lib \
    $(_COMMONOAKROOT)\lib\$(_CPUDEPPATH)\nkstub.lib \
    $(_COMMONOAKROOT)\lib\$(_CPUDEPPATH)\oemstub.lib \
    $(_PLATCOMMONLIB)\$(_CPUDEPPATH)\oal_kitl.lib \
    $(_PLATCOMMONLIB)\$(_CPUDEPPATH)\kitl_log.lib \
    $(_PLATCOMMONLIB)\$(_CPUINDPATH)\oal_memory_arm.lib \
    $(_COMMONOAKROOT)\lib\$(_CPUINDPATH)\fulllibc.lib \

SOURCES= \
    kitl.c \
    kitlSerDrv.c \

